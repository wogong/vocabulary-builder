{
  "manifest_version": 3,
  "name": "Vocabulary Builder",
  "version": "0.1.0",
  "description": "双击网页上的生词，连同所在句子一起收进 Anki 牌组。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sentence.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
