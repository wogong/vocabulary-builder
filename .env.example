# Copy to .env and fill in. Spec §5.5 (P0 subset).

# --- core ---
ANKI_COLLECTION_PATH=/data/anki/collection.anki2
ANKI_DECK=Vocab::Reading
ANKI_NOTETYPE=VocabContext
INBOX_DB=/data/app/inbox.db

# --- ports ---
# Each service listens on this port inside its container and is published to
# 127.0.0.1 on the same number. Point cloudflared at these.
APP_PORT=8000
SYNC_SERVER_PORT=8080

# --- sync (self-hosted, D7) ---
# SYNC_ENDPOINT is not set here: docker-compose derives it from
# SYNC_SERVER_PORT so the two cannot drift. Set it manually only when running
# the app outside compose.
SYNC_USERNAME=vocab
SYNC_PASSWORD=change-me
SYNC_DEBOUNCE_SEC=60
SYNC_INTERVAL_SEC=1800

# --- auth ---
# label:token pairs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKENS=chrome:change-me-too

# --- dictionaries (P1, optional) ---
# Fetch with: uv run python scripts/fetch_dicts.py --dest data/dict
# ECDICT is ~800 MB — keep it OUT of a synced folder (Dropbox/iCloud).
# Leave blank to run without: words are still captured, just unannotated.
ECDICT_PATH=/data/dict/stardict.db
CEDICT_PATH=/data/dict/cedict.txt.gz

# --- policy ---
MAX_CONTEXTS_PER_NOTE=5
# Words ranked this common (COCA) are flagged as 常见词 in the lookup card.
MIN_FREQ_RANK=3000

# --- backups (scripts/backup.py) ---
BACKUP_DIR=/data/backup
