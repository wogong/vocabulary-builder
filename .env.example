# Copy to .env and fill in. Spec §5.5 (P0 subset).

# --- host paths ---
# Where the collection, inbox.db and sync server state live on the host.
# Keep this OUT of a synced folder (Dropbox/iCloud): the collection is a live
# SQLite database and media runs to hundreds of MB.
DATA_DIR=./data

# --- core ---
ANKI_COLLECTION_PATH=/data/anki/collection.anki2
ANKI_DECK=Vocab::Reading
ANKI_NOTETYPE=VocabContext
INBOX_DB=/data/app/inbox.db

# --- ports ---
# Each service listens on this port inside its container and is published to
# 127.0.0.1 on the same number. Point cloudflared at these.
APP_PORT=8000
SYNC_SERVER_PORT=8080

# --- sync (self-hosted, D7) ---
# SYNC_ENDPOINT is not set here: docker-compose derives it from
# SYNC_SERVER_PORT so the two cannot drift. Set it manually only when running
# the app outside compose.
SYNC_USERNAME=vocab
SYNC_PASSWORD=change-me
SYNC_DEBOUNCE_SEC=60
SYNC_INTERVAL_SEC=1800

# --- auth ---
# label:token pairs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKENS=chrome:change-me-too

# --- dictionaries (P1, optional) ---
# Fetch with: uv run python scripts/fetch_dicts.py --dest "$DATA_DIR/dict"
# Paths below are inside the container; DATA_DIR maps to /data on the host.
# ECDICT is ~800 MB. Leave blank to run without: words are still captured,
# just unannotated.
ECDICT_PATH=/data/dict/stardict.db
CEDICT_PATH=/data/dict/cedict.txt.gz

# --- policy ---
MAX_CONTEXTS_PER_NOTE=5
# Words ranked this common (COCA) are flagged as 常见词 in the lookup card.
MIN_FREQ_RANK=3000

# --- telegram bot (P2, optional; blank disables it) ---
TG_BOT_TOKEN=
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
TG_WEBHOOK_SECRET=
# Only these chat ids are answered. Get yours by messaging @userinfobot.
TG_ALLOWED_CHAT_IDS=
# Public HTTPS base (the cloudflared hostname). Set it and the webhook
# registers itself on startup; leave blank to register by hand with
# scripts/set_webhook.py. Telegram allows one webhook per bot token, so a
# second deployment sharing the token takes delivery away from the first.
TG_PUBLIC_URL=
TG_TIMEZONE=Asia/Shanghai
TG_REMINDER_TIMES=09:00,21:00
TG_QUIET_HOURS=23:00-08:00
# Writing quiz results back into Anki's scheduler means two writers on one
# card's state. Leave off (D6).
BOT_REVIEW_WRITES_BACK=false

# --- pronunciation (P2) ---
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural

# --- sentence translation (optional, OpenAI-compatible endpoint) ---
# Off by default (decision B2). Without it the bot still picks out the
# candidate words, which is the half that matters.
LLM_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SEC=15

# --- backups (scripts/backup.py) ---
BACKUP_DIR=/data/backup
